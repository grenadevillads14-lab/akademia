{
  "name": "akademia",
  "version": "0.0.1",
  "private": true,
  "description": "Akademeia: a third-person 3D exploration and story game set at Plato's Academy, Athens, 367-335 BC.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "howler": "^2.2.4",
    "inkjs": "^2.4.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
